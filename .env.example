# TrendPublish 运行配置
# 复制此文件为 .env 并填入实际值

# ── 服务器 ────────────────────────────────────────────────
TRENDPUBLISH_API_KEY=change-me
TRENDPUBLISH_PORT=8000

# 运行环境：local | docker | cloudflare
TRENDPUBLISH_RUNTIME=local

# ── 数据库 ────────────────────────────────────────────────
TRENDPUBLISH_SQLITE_PATH=data/trendpublish.sqlite3

# ── 可观测性 ──────────────────────────────────────────────
TRENDPUBLISH_ENV=local
OTEL_ENABLED=true
OTEL_SERVICE_NAME=trendpublish

# 标准输出日志（format: json | pretty）
OTEL_STDOUT_ENABLED=false
OTEL_STDOUT_FORMAT=json

# HTTP 导出（留空则禁用）
#OTEL_HTTP_ENDPOINT=https://otel-collector.example.com/v1/logs
#OTEL_HTTP_TOKEN=

# Axiom（留空则禁用）
#AXIOM_DATASET=
#AXIOM_TOKEN=

# Better Stack（留空则禁用）
#BETTERSTACK_SOURCE_TOKEN=

# ── Cloudflare smoke test ─────────────────────────────────
#TRENDPUBLISH_CF_URL=https://your-worker.workers.dev
